{
  "env_id": "ALE/SpaceInvaders-v5",
  "seed": 42,
  "device": "cpu",
  "observation_type": "pixels",
  "preprocess": {
    "grayscale": true,
    "resize_width": 84,
    "resize_height": 84,
    "frame_stack": 4,
    "frame_skip": 4,
    "reward_clip": true,
    "terminal_on_life_loss": true,
    "no_op_max": 30
  },
  "dqn": {
    "gamma": 0.99,
    "learning_rate": 0.00025,
    "optimizer": "rmsprop",
    "batch_size": 32,
    "replay_capacity": 1000000,
    "target_update_steps": 10000,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "epsilon_decay_frames": 200000,
    "dueling": true,
    "noisy": true,
    "n_step": 3,
    "per_alpha": 0.6,
    "per_beta_start": 0.4,
    "per_beta_frames": 10000000,
    "efficient_replay": true
  },
  "training": {
    "total_frames": 10000000,
    "learning_starts": 20000,
    "update_every_frames": 4,
    "eval_every_frames": 200000,
    "eval_episodes": 5,
    "eval_epsilon": 0.05,
    "checkpoint_every_frames": 200000,
    "log_events": true,
    "log_every_frames": 20000,
    "early_stop_avg_reward": 400,
    "early_stop_min_frames": 2000000,
    "early_stop_eval_windows": 2,
    "plateau_gate_enabled": true,
    "plateau_min_frames": 500000,
    "plateau_eval_windows": 2,
    "plateau_perf_delta": 10,
    "plateau_perf_p_threshold": 0.2,
    "plateau_bootstrap_samples": 200,
    "plateau_churn_threshold": 0.01,
    "plateau_gap_delta": 0.0,
    "plateau_td_improve_threshold": 0.0,
    "plateau_probe_states": 256,
    "td_error_ema_alpha": 0.05,
    "plateau_action": "epsilon_boost",
    "plateau_stop_after_action": false,
    "plateau_action_cooldown_frames": 500000,
    "plateau_epsilon_boost": 0.1,
    "plateau_boost_frames": 200000,
    "plateau_lr_decay": 0.5,
    "progress_targets": [
      {"frame": 200000, "min_score": 5, "label": "early-signal"},
      {"frame": 500000, "min_score": 20, "label": "ramp"},
      {"frame": 1000000, "min_score": 50, "label": "midpoint"},
      {"frame": 1500000, "min_score": 100, "label": "momentum"},
      {"frame": 2000000, "min_score": 200, "label": "pre-strong"}
    ],
    "num_threads": 8,
    "interop_threads": 2,
    "resume_from": "models/ALE_SpaceInvaders-v5_latest.pt",
    "resume_metrics": true
  }
}
